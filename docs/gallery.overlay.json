{
  "version": 2,
  "name": "widget-gallery",
  "canvas": { "w": 1600, "h": 920, "mode": "free", "theme": "nord-console" },
  "prompt": {
    "user": "gallery",
    "cmd": "./now-monitor --widgets=26",
    "cursor": true,
    "size": 19,
    "x": 24,
    "y": 16
  },
  "widgets": [
    {
      "type": "cards",
      "x": 24, "y": 70, "w": 680, "cols": 2, "gap": 24,
      "items": [
        {
          "key": "cpu", "label": "CPU",
          "bar": "cpu.usage",
          "value": [{ "metric": "cpu.usage" }],
          "sub": [{ "metric": "cpu.power_w" }, { "metric": "cpu.clock_mhz" }],
          "spark": "cpu.usage"
        },
        {
          "key": "ram", "label": "内存",
          "bar": "ram.pct",
          "value": [{ "metric": "ram.pct" }],
          "sub": [{ "metric": "ram.used" }, { "metric": "ram.total" }],
          "spark": "net.down_mbps"
        }
      ]
    },
    {
      "type": "chips",
      "x": 24, "y": 266, "w": 680, "fit": "shrink",
      "items": ["net.up_mbps", "net.down_mbps", "ram.pct", "misc.dimm_max"]
    },
    {
      "type": "panel",
      "x": 760, "y": 70, "w": 340, "h": 110,
      "style": { "bg": { "color": "#3b4252", "alpha": 60, "radius": 14, "border": 1 } }
    },
    {
      "type": "value",
      "x": 784, "y": 104, "w": 300, "size": 19, "show_name": true,
      "metrics": { "digits": 1, "metrics": [{ "metric": "cpu.power_w" }, { "metric": "cpu.clock_mhz" }] }
    },
    { "type": "icon", "x": 1140, "y": 90, "size": 36, "name": "cpu" },
    { "type": "image", "x": 1200, "y": 70, "w": 120, "h": 80 },
    { "type": "gauge", "x": 1360, "y": 70, "size": 96, "metric": "cpu.usage", "label": "CPU" },
    { "type": "stat", "x": 760, "y": 200, "size": 26, "metric": "ram.pct", "label": "内存" },
    {
      "type": "progress",
      "x": 24, "y": 330, "w": 300, "metric": "ram.pct"
    },
    { "type": "spark", "x": 360, "y": 320, "w": 240, "h": 48, "samples": 40, "metric": "net.down_mbps" },
    { "type": "bars", "x": 630, "y": 320, "w": 240, "h": 48, "samples": 40, "metric": "cpu.usage" },
    {
      "type": "text",
      "x": 900, "y": 330, "size": 19,
      "text": "文字插值：内存 {ram.pct} · 下行 {net.down_mbps}"
    },
    { "type": "html", "x": 900, "y": 372, "w": 320, "h": 28, "html": "静态 HTML · {time}" },
    { "type": "divider", "x": 24, "y": 396, "w": 280, "thickness": 3 },
    {
      "type": "badge",
      "x": 24, "y": 430, "size": 15,
      "text": "注册但缺传感器（tmiss 演示）：{misc.mobo_temp}"
    },
    { "type": "progress", "x": 24, "y": 540, "w": 14, "h": 90, "orientation": "v", "metric": "cpu.usage" },
    { "type": "gauge", "x": 90, "y": 540, "size": 96, "arc": "half", "metric": "ram.pct", "label": "内存", "style": { "show_needle": true } },
    { "type": "spark", "x": 250, "y": 540, "w": 240, "h": 48, "samples": 40, "metric": "net.up_mbps", "style": { "show_peak": true } },
    { "type": "text", "x": 520, "y": 560, "size": 14, "text": "N2 新摆法：竖 progress（D3-A 箱即条） · half 仪表+指针 · spark 峰值标注" },
    { "type": "stackbar", "x": 24, "y": 620, "w": 300, "metrics": { "metrics": ["ram.used", "ram.total"] } },
    { "type": "stackbar", "x": 24, "y": 660, "w": 300, "metrics": { "metrics": ["ram.used", "ram.total", "misc.mobo_temp"] } },
    { "type": "stackbar", "x": 24, "y": 700, "w": 300, "metrics": { "metrics": ["misc.mobo_temp"] } },
    { "type": "text", "x": 420, "y": 620, "size": 14, "text": "N3：堆叠条 正常/部分缺/全缺 · 状态灯 正常/告警(≥90 复现法同上)/缺数据" },
    { "type": "light", "x": 820, "y": 620, "metric": "cpu.usage", "label": "CPU" },
    { "type": "light", "x": 910, "y": 620, "metric": "ram.pct", "label": "内存" },
    { "type": "light", "x": 1000, "y": 620, "metric": "misc.mobo_temp", "label": "主板" }
  ]
}
